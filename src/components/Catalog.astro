---
import type { Product } from "../lib/products";
import { categories } from "../data/categories";
import { content } from "../data/content";
import { href } from "../config";
import ProductCard from "./ProductCard.astro";

interface Props {
  title: string;
  lede?: string;
  current: string;
  products: Product[];
}

const { title, lede, current, products } = Astro.props;
---

<section class="wrap pt-4 pb-20 md:pt-8 md:pb-28" data-catalog data-catalog-mode={current}>
  <script is:inline define:vars={{ mode: current }}>
    (function () {
      var parts = location.pathname.split("/").filter(Boolean);
      var index = parts.lastIndexOf("katalog");
      var slug = index >= 0 ? parts[index + 1] : "";
      if (slug && slug.indexOf(".") === -1 && mode === "all") {
        document.documentElement.dataset.liveShelf = slug;
      }
    })();
  </script>
  <h1 class="font-display text-[clamp(44px,7vw,80px)] leading-[0.95]" data-catalog-title>{title}</h1>
  <p class="handmade mt-4">Сделано вручную</p>
  <p class="mt-3 text-lg text-quiet" data-catalog-lede hidden={!lede}>{lede}</p>

  <nav class="mt-8 flex flex-wrap gap-x-5 gap-y-2" aria-label="Категории" data-catalog-nav>
    <a class="nav-link" href={href("/katalog")} aria-current={current === "all" ? "page" : undefined}>Все</a>
    {
      categories.map((category) => (
        <a
          class="nav-link"
          href={href(`/katalog/${category.slug}`)}
          aria-current={current === category.slug ? "page" : undefined}
        >
          {category.title}
        </a>
      ))
    }
  </nav>

  <p class="mt-14 max-w-md text-lg" data-catalog-empty hidden={products.length > 0}>
    <span data-text="empty.first">{content.empty.first}</span>
    {" "}
    <span data-text="empty.second">{content.empty.second}</span>
  </p>
  <ul class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-catalog-grid hidden={products.length === 0}>
    {
      products.map((product) => (
        <li>
          <ProductCard product={product} />
        </li>
      ))
    }
  </ul>
</section>
