---
import Base from "../layouts/Base.astro";
import { href } from "../config";

const root = href("/").replace(/\/$/, "");
---

<Base title="Корзина — Гипс и пламя" noindex page="cart">
  <section class="wrap pt-4 pb-8 md:pt-8 md:pb-16" data-root={root}>
    <h1 class="font-display text-[clamp(44px,7vw,80px)] leading-[0.95]">Корзина</h1>
    <p class="handmade mt-4">Сделано вручную</p>
    <p class="mt-6 max-w-md text-lg" data-cart-empty>
      Пока пусто. <a class="quiet-link" href={href("/katalog")}>Смотреть изделия</a>
    </p>
    <form id="order-form" class="mt-8 grid max-w-2xl gap-5" hidden>
      <ul class="grid gap-4" data-cart-lines></ul>
      <p class="cart-offer" data-cart-offer hidden></p>
      <p class="text-xl" data-cart-total></p>
      <label class="grid gap-2">
        Имя
        <input class="field" name="name" required minlength="2" maxlength="80" autocomplete="name" />
      </label>
      <label class="grid gap-2">
        Контакт для ответа
        <input
          class="field"
          name="contact"
          required
          minlength="5"
          maxlength="120"
          autocomplete="tel"
          placeholder="Телефон, Telegram или почта"
        />
      </label>
      <label class="grid gap-2">
        Комментарий
        <textarea class="field min-h-28" name="note" maxlength="1000"></textarea>
      </label>
      <input class="hidden" name="company" tabindex="-1" autocomplete="off" />
      <button class="btn btn-ink w-full sm:w-auto" type="submit">Оформить заказ</button>
      <p data-order-status role="status"></p>
    </form>
    <div data-order-done hidden>
      <p class="order-number mt-8 font-display text-[clamp(40px,6vw,64px)] leading-none" data-order-number></p>
      <p class="mt-4 max-w-md text-lg">Заказ принят. Ответим на контакт, который вы оставили.</p>
      <a class="btn btn-ink mt-8" href={href("/katalog")}>К изделиям</a>
    </div>
  </section>
  <script>
    const cartKey = "gips-cart";
    const form = document.getElementById("order-form");
    const empty = document.querySelector("[data-cart-empty]");
    const lines = document.querySelector("[data-cart-lines]");
    const offerNode = document.querySelector("[data-cart-offer]");
    const totalNode = document.querySelector("[data-cart-total]");
    const statusNode = document.querySelector("[data-order-status]");
    const done = document.querySelector("[data-order-done]");
    const numberNode = document.querySelector("[data-order-number]");
    const root = document.querySelector("[data-root]")?.getAttribute("data-root") || "";
    let catalog = [];
    let popups = [];

    function readOfferCode() {
      return String(localStorage.getItem("gips-offer") || "")
        .trim()
        .toUpperCase();
    }

    function activeOffer() {
      const code = readOfferCode();
      if (!/^[A-Z0-9]{3,12}$/.test(code)) return null;
      return popups.find((popup) => popup.code === code && popup.kind !== "message") || null;
    }

    function offerOff(sum, offer) {
      if (!offer || offer.kind !== "discount") return 0;
      const value = Number(offer.value) || 0;
      if (offer.mode === "amount") return Math.min(sum, value);
      return Math.min(sum, Math.floor((sum * value) / 100));
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
    }

    function money(value) {
      return `${new Intl.NumberFormat("ru-RU").format(value).replace(/[\u00A0\u202F]/g, " ")}\u00A0₽`;
    }

    function readCart() {
      try {
        const data = JSON.parse(localStorage.getItem(cartKey) || "[]");
        return Array.isArray(data) ? data : [];
      } catch {
        return [];
      }
    }

    function paint() {
      if (!(form instanceof HTMLFormElement) || !(lines instanceof HTMLElement) || !(empty instanceof HTMLElement)) return;
      const cart = readCart();
      if (!cart.length) {
        form.hidden = true;
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      form.hidden = false;
      let known = 0;
      let later = false;
      lines.innerHTML = cart
        .map((row) => {
          const product = catalog.find((item) => item.id === row.id);
          const title = product?.title || row.id;
          const price = product ? product.price : null;
          if (price == null) later = true;
          else known += price * row.qty;
          const priceText = !product ? "нет на сайте" : price == null ? "цену напишем" : money(price);
          const key = product?.images?.[0] || "";
          const photo = /^media\/[a-z0-9][a-z0-9_-]{0,40}\/[a-z0-9][a-z0-9_-]{0,40}\.jpg$/.test(key)
            ? `<img class="cart-photo" alt="" src="${escapeHtml(`${root}/${key}`)}">`
            : `<span class="cart-photo" aria-hidden="true"></span>`;
          const href = `${root}/izdelie/${encodeURIComponent(row.id)}`;
          return `<li class="cart-line"><a class="cart-product" href="${escapeHtml(href)}">${photo}<span><span class="block text-sm text-quiet">${escapeHtml(row.id)}</span><span class="cart-title">${escapeHtml(title)}</span><span class="mt-2 block">${escapeHtml(priceText)}</span></span></a><div class="cart-actions"><label class="flex items-center gap-2">Шт<input class="field w-20" data-qty="${escapeHtml(row.id)}" type="number" min="1" max="20" value="${row.qty}"></label><button class="cart-remove" type="button" data-remove="${escapeHtml(row.id)}">Убрать</button></div></li>`;
        })
        .join("");
      const offer = activeOffer();
      const off = later ? 0 : offerOff(known, offer);
      if (offerNode instanceof HTMLElement) {
        offerNode.replaceChildren();
        if (!offer) offerNode.hidden = true;
        else {
          offerNode.hidden = false;
          const label = document.createElement("span");
          if (offer.kind === "gift") label.textContent = `Подарок: ${offer.gift || offer.title}`;
          else if (later) label.textContent = `Скидка ${offer.mode === "amount" ? money(Number(offer.value) || 0) : `${offer.value}%`} посчитается, когда будут все цены.`;
          else label.textContent = `Скидка ${offer.mode === "amount" ? money(Number(offer.value) || 0) : `${offer.value}%`}: −${money(off)}`;
          const clear = document.createElement("button");
          clear.type = "button";
          clear.className = "cart-remove";
          clear.dataset.offerClear = "";
          clear.textContent = "Убрать";
          offerNode.append(label, clear);
        }
      }
      if (totalNode) {
        const payable = known - off;
        totalNode.textContent = later
          ? `Известная сумма ${money(known)}. Остальное напишем в переписке.`
          : `Итого ${money(payable)}`;
      }
      lines.querySelectorAll("img.cart-photo").forEach((img) => {
        img.addEventListener("error", () => {
          const blank = document.createElement("span");
          blank.className = "cart-photo";
          blank.setAttribute("aria-hidden", "true");
          img.replaceWith(blank);
        });
      });
    }

    async function loadCatalog() {
      try {
        const response = await fetch("/api/content", { cache: "no-store" });
        if (!response.ok) return;
        const data = await response.json();
        catalog = Array.isArray(data.products) ? data.products : [];
        popups = Array.isArray(data.popups) ? data.popups : [];
      } catch {
        catalog = [];
      }
      paint();
    }

    offerNode?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest("[data-offer-clear]")) return;
      localStorage.removeItem("gips-offer");
      paint();
    });

    lines?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest("[data-remove]");
      if (!(button instanceof HTMLButtonElement)) return;
      const id = button.dataset.remove || "";
      const cart = readCart().filter((row) => row.id !== id);
      localStorage.setItem(cartKey, JSON.stringify(cart));
      document.dispatchEvent(new CustomEvent("gips-cart"));
      paint();
    });

    lines?.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || !target.dataset.qty) return;
      const qty = Number(target.value);
      const cart = readCart()
        .map((row) => (row.id === target.dataset.qty ? { ...row, qty } : row))
        .filter((row) => Number.isInteger(row.qty) && row.qty > 0 && row.qty <= 20);
      localStorage.setItem(cartKey, JSON.stringify(cart));
      document.dispatchEvent(new CustomEvent("gips-cart"));
      paint();
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !(statusNode instanceof HTMLElement)) return;
      const data = new FormData(form);
      const cart = readCart();
      statusNode.textContent = "Отправляю…";
      try {
        const response = await fetch("/api/order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: String(data.get("name") || ""),
            contact: String(data.get("contact") || ""),
            note: String(data.get("note") || ""),
            company: String(data.get("company") || ""),
            offer: readOfferCode(),
            items: cart.map((row) => ({ id: row.id, qty: row.qty })),
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          if (result.error === "offer_used") {
            localStorage.removeItem("gips-offer");
            paint();
            statusNode.textContent = "Эта акция уже была с этим контактом. Заказ без бонуса можно отправить ещё раз.";
            return;
          }
          statusNode.textContent =
            result.error === "cart_changed"
              ? "Часть изделий уже не на сайте. Обновите корзину."
              : result.error === "offer_check"
                ? "Не удалось проверить акцию. Попробуйте ещё раз."
                : "Не получилось. Проверьте имя и контакт.";
          return;
        }
        localStorage.removeItem(cartKey);
        localStorage.removeItem("gips-offer");
        document.dispatchEvent(new CustomEvent("gips-cart"));
        form.hidden = true;
        if (empty instanceof HTMLElement) empty.hidden = true;
        if (done instanceof HTMLElement) done.hidden = false;
        if (numberNode) numberNode.textContent = result.number || "Заказ принят";
      } catch {
        statusNode.textContent = "Нет связи с мастерской. Попробуйте ещё раз.";
      }
    });

    document.addEventListener("gips-cart", paint);
    document.addEventListener("gips-offer", paint);
    loadCatalog();
  </script>
</Base>
