---
import { href } from "../config";
import Flame from "./Flame.astro";
---

<header class="wrap flex flex-wrap items-center justify-between gap-x-5 gap-y-3 py-4 sm:py-5">
  <a href={href("/")} class="inline-flex min-h-11 items-center gap-2.5 font-display text-[1.55rem] leading-none font-medium text-ink sm:text-[1.7rem]">
    <Flame class="h-9 w-9 shrink-0" />
    <span>Гипс <span class="italic">и</span> пламя</span>
  </a>
  <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.98rem]" aria-label="Разделы">
    <a class="nav-link inline-flex min-h-11 items-center whitespace-nowrap" href={href("/katalog")}>Изделия</a>
    <a class="nav-cart inline-flex min-h-11 items-center whitespace-nowrap" href={href("/korzina")}>
      <span class="nav-link">Корзина</span><span class="cart-count" data-cart-count hidden></span>
    </a>
    <a class="nav-link inline-flex min-h-11 items-center whitespace-nowrap" href={href("/#o-masterskoy")}>О мастерской</a>
  </nav>
</header>
