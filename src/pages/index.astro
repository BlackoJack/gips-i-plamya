---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Categories from "../components/Categories.astro";
import Postcard from "../components/Postcard.astro";
import Order from "../components/Order.astro";
import About from "../components/About.astro";
import Reviews from "../components/Reviews.astro";
import ProductCard from "../components/ProductCard.astro";
import { content } from "../data/content";
import { getFeatured } from "../lib/products";

const featured = await getFeatured();
---

<Base page="home">
  <Hero />
  <Categories />
  <section class="wrap rise pb-16 md:pb-20" data-shelf hidden={featured.length === 0}>
    <h2 class="font-display text-[clamp(36px,5vw,56px)] leading-none" data-text="shelf">{content.shelf}</h2>
    <p class="handmade mt-4">Сделано вручную</p>
    <ul class="mt-8 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-shelf-grid>
      {
        featured.map((product) => (
          <li>
            <ProductCard product={product} level="h3" />
          </li>
        ))
      }
    </ul>
  </section>
  <Postcard />
  <Order />
  <About />
  <Reviews />
</Base>
