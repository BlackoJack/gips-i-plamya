---
import Base from "../layouts/Base.astro";
import { config, href } from "../config";
import { content } from "../data/content";
---

<Base title={`${content.notFound} — ${config.name}`} noindex={true}>
  <section class="wrap py-20 md:py-28">
    <h1 class="font-display text-[clamp(40px,6vw,72px)] leading-[0.95]">{content.notFound}</h1>
    <a class="btn btn-ink mt-8" href={href("/katalog")}>Смотреть изделия</a>
  </section>
</Base>
