---
import { Image } from "astro:assets";
import { content } from "../data/content";
import { config, href } from "../config";
import still from "../assets/brand/still-life.jpg";
---

<section class="wrap grid items-end gap-8 pt-2 pb-12 md:grid-cols-[1.05fr_0.95fr] md:gap-12 md:pt-6 md:pb-20">
  <div>
    <span class="mb-5 block h-px w-10 bg-flame" aria-hidden="true"></span>
    <p class="text-quiet" data-text="hero.kicker">{content.hero.kicker}</p>
    <h1 class="mt-3 text-[clamp(44px,8vw,92px)] leading-[0.92] tracking-[-0.02em]">
      <span class="block">Гипс</span>
      <span class="block"><span class="italic">и</span> пламя</span>
    </h1>
    <p class="mt-5 max-w-md text-lg text-quiet" data-text="hero.line">{content.hero.line}</p>
    <p class="mt-2 text-sm text-quiet">{config.city}</p>
    <div class="mt-8">
      <a class="btn btn-ink" href={href("/katalog")} data-text="hero.catalog">{content.hero.catalog}</a>
    </div>
  </div>
  <figure class="m-0">
    <Image
      src={still}
      alt={content.alts.hero}
      widths={[420, 640, 840]}
      sizes="(min-width: 768px) 46vw, 100vw"
      format="jpg"
      quality={78}
      loading="eager"
      fetchpriority="high"
      class="h-auto w-full rounded-[2px]"
    />
    <figcaption class="handmade mt-4">Сделано вручную</figcaption>
  </figure>
</section>
