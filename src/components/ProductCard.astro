---
import { Image } from "astro:assets";
import type { Product } from "../lib/products";
import { imagesOf } from "../lib/products";
import { categoryById } from "../data/categories";
import { content } from "../data/content";
import { href, money } from "../config";

interface Props {
  product: Product;
  level?: "h2" | "h3";
}

const { product, level = "h2" } = Astro.props;
const Title = level;
const category = categoryById(product.data.category);
const cover = imagesOf(product)[0];
const price = product.data.price === null ? content.product.priceLater : money(product.data.price);
---

<a href={href(`/izdelie/${product.id}`)} class="group block">
  <Image
    src={cover}
    alt=""
    widths={[360, 540, 720]}
    sizes="(min-width: 1024px) 340px, (min-width: 640px) 46vw, 100vw"
    quality={74}
    loading="lazy"
    class="aspect-[4/5] w-full rounded-[2px] object-cover"
  />
  <p class="mt-4 text-sm text-quiet">{category?.title}</p>
  <Title class="mt-1 font-display text-[2rem] leading-none font-medium group-hover:underline group-hover:decoration-flame group-hover:underline-offset-[0.14em]">
    {product.data.title}
  </Title>
  <p class="mt-2 max-w-sm text-quiet">{product.data.summary}</p>
  <p class="mt-2">{price}</p>
</a>
