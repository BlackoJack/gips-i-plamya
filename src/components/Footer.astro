---
import { config, href } from "../config";

const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
  <div class="site-footer-line">
    <p>{config.name}</p>
    <a class="quiet-link inline-flex min-h-11 items-center" href={href("/katalog")}>Изделия</a>
    <a class="quiet-link inline-flex min-h-11 items-center" href={href("/korzina")}>Корзина</a>
    <p>{year}</p>
  </div>
  <p class="handmade mt-5">Изделия ручной работы</p>
  <p class="mt-2 text-sm text-quiet">{config.city}</p>
  <nav class="contact-row mt-5" data-contacts hidden aria-label="Написать"></nav>
  <p class="mt-5 text-sm text-quiet" data-groups-label hidden>Группы</p>
  <nav class="contact-row mt-2" data-groups hidden aria-label="Группы"></nav>
</footer>
